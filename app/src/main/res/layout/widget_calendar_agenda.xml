<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/agenda_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/agenda_title"
                style="@style/WidgetLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:fontFamily="@font/vazirmatn_bold"
                android:paddingStart="4dp"
                android:text="@string/widget_agenda_label"
                android:textSize="14sp" />

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <ImageView
                    android:id="@+id/agenda_add_bg"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_pill_bg"
                    android:tint="@color/widget_surface_high" />

                <ImageButton
                    android:id="@+id/widget_add"
                    style="@style/WidgetAction"
                    android:contentDescription="@string/widget_add_reminder"
                    android:src="@drawable/ic_widget_add" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <ImageView
                    android:id="@+id/widget_configure_bg"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_pill_bg"
                    android:tint="@color/widget_surface_high" />

                <ImageButton
                    android:id="@+id/widget_configure"
                    style="@style/WidgetAction"
                    android:contentDescription="@string/widget_configure"
                    android:src="@drawable/ic_widget_settings" />
            </FrameLayout>
        </LinearLayout>

        <ListView
            android:id="@+id/agenda_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="6dp"
            android:listSelector="@android:color/transparent" />

        <TextView
            android:id="@+id/agenda_empty"
            style="@style/WidgetLabel"
            android:layout_height="match_parent"
            android:gravity="center"
            android:maxLines="4"
            android:text="@string/widget_agenda_empty" />
    </LinearLayout>
</FrameLayout>
