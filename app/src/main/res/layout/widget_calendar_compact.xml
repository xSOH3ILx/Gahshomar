<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/compact_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="8dp">

        <ImageView
            android:id="@+id/compact_pill_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_card_inner_bg"
            android:tint="@color/widget_primary_container" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:layoutDirection="rtl"
            android:orientation="vertical"
            android:paddingHorizontal="6dp"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/compact_day_of_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/vazirmatn_medium"
                android:maxLines="1"
                android:text="@string/widget_today"
                android:textColor="@color/widget_on_primary_container"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/compact_day_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_bold"
                android:includeFontPadding="false"
                android:text="@string/widget_sample_day"
                android:textColor="@color/widget_on_primary_container"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/compact_month_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/vazirmatn_bold"
                android:maxLines="1"
                android:text="@string/widget_sample_month"
                android:textColor="@color/widget_on_primary_container"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/compact_reminder_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/vazirmatn_medium"
                android:maxLines="1"
                android:textSize="9sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
