<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/week_widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="rtl">
    <ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_bg" android:importantForAccessibility="no" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="10dp" android:paddingVertical="4dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/week_title" style="@style/WidgetLabel" android:layout_width="0dp" android:layout_weight="1" android:fontFamily="@font/vazirmatn_bold" android:text="@string/widget_week_label" />
            <ImageButton android:id="@+id/widget_add" style="@style/WidgetAction" android:src="@drawable/ic_widget_add" android:contentDescription="@string/widget_add_reminder" />
            <ImageButton android:id="@+id/widget_configure" style="@style/WidgetAction" android:src="@drawable/ic_widget_settings" android:contentDescription="@string/widget_configure" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <TextView android:id="@+id/week_cell_0" style="@style/WidgetCalendarCell" android:maxLines="3" />
            <TextView android:id="@+id/week_cell_1" style="@style/WidgetCalendarCell" android:maxLines="3" />
            <TextView android:id="@+id/week_cell_2" style="@style/WidgetCalendarCell" android:maxLines="3" />
            <TextView android:id="@+id/week_cell_3" style="@style/WidgetCalendarCell" android:maxLines="3" />
            <TextView android:id="@+id/week_cell_4" style="@style/WidgetCalendarCell" android:maxLines="3" />
            <TextView android:id="@+id/week_cell_5" style="@style/WidgetCalendarCell" android:maxLines="3" />
            <TextView android:id="@+id/week_cell_6" style="@style/WidgetCalendarCell" android:maxLines="3" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
