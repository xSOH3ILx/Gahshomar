        <exclude domain="database" path="soh3il_calendar.db-shm" />
        <exclude domain="database" path="soh3il_calendar.db-wal" />
        <exclude domain="sharedpref" path="soh3il_user_preferences.xml" />
        <exclude domain="sharedpref" path="pending_snoozes.xml" />
        <exclude domain="sharedpref" path="scheduled_main_alarms.xml" />
